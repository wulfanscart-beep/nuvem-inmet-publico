# Exporte as variáveis no shell. O projeto não carrega arquivos .env.
NUVEM_INMET_DATA=./data
# URL HTTPS direta de um CSV horário convencional renovado pela fonte.
INMET_BDMEP_CSV_URL=
# Projeto responsável pelos jobs BigQuery. Não é uma credencial.
GOOGLE_CLOUD_PROJECT=
# Use Application Default Credentials por meio do gcloud ou da identidade do runtime.
